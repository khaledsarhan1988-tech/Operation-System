NODE_ENV=development
PORT=3001
# REQUIRED in production — the server refuses to start if these are unset there.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=__set_a_64_char_random_hex_secret__
JWT_REFRESH_SECRET=__set_a_DIFFERENT_64_char_random_hex_secret__
# Initial admin seed — use a STRONG unique password, then change it after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__set_a_strong_password__
ADMIN_FULLNAME=System Admin
DB_PATH=./data/academy.db
# Comma-separated allow-list of front-end origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
